DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Neon PostgreSQL connection string. Use the same variable for local and production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Production (Render): the service hostname is added automatically from RENDER_EXTERNAL_HOSTNAME.
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=mess-meal-management-system-backend.onrender.com
# CORS_ALLOWED_ORIGINS=https://messdiary.vercel.app
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# SERVE_MEDIA=true   # let Django serve uploaded receipts/photos (defaults to DEBUG)

# Upstash Redis (REST) cache. Put the real values in .env.local (untracked), never in this file.
# Leave both unset to run without a cache.
# UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# REDIS_CACHE_ENABLED=true
# REDIS_KEY_PREFIX=mess:v1        # use a different prefix per environment sharing one Redis
# REDIS_TIMEOUT=1.5               # seconds per Redis call before giving up
# REDIS_BREAKER_SECONDS=30        # skip Redis this long after a failure
# REDIS_TTL_OPEN=120              # seconds to cache an open month's reports
# REDIS_TTL_CLOSED=600            # seconds to cache a closed month's reports
